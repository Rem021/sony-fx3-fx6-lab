+def elf_section_fingerprints(path,names):
+    raw = path.read_bytes()
+    if len(raw)<64 or raw[:6] != b'\x7fELF\x02\x01' or struct.unpack_from('<H',raw,18)[0]!=183:
+        raise RuntimeError('expected AArch64 ELF64 little-endian shim')
+    shoff = struct.unpack_from('<Q',raw,40)[0]
+    entsize,count,strings = struct.unpack_from('<HHH',raw,58)
+    if entsize != 64 or count == 0 or strings >= count or shoff+count*64 > len(raw):
+        raise RuntimeError('shim section table invalid')
+    table = [struct.unpack_from('<IIQQQQIIQQ',raw,shoff+i*64) for i in range(count)]
+    st = table[strings]
+    names_raw = raw[st[4]:st[4]+st[5]]
+    found = {}
+    for section in table:
+        off = section[0]
+        if off >= len(names_raw):
+            raise RuntimeError('shim section name invalid')
+        stop = names_raw.find(b'\0',off)
+        if stop < 0:
+            raise RuntimeError('shim section name unterminated')
+        name = names_raw[off:stop].decode('ascii')
+        if name in names:
+            if (section[1] != 8 and section[4]+section[5] > len(raw)) or name in found:
+                raise RuntimeError('shim section payload invalid')
+            found[name] = {'present':True,'type':section[1],'flags':section[2],'vma':section[3],'bytes':section[5]}
+            if section[1] != 8:
+                found[name]['sha256'] = hashlib.sha256(raw[section[4]:section[4]+section[5]]).hexdigest()
+    for name in set(names)-set(found):
+        if name != '.got':
+            raise RuntimeError('required reproduced shim section absent')
+        found[name] = {'present':False}
+    return found
