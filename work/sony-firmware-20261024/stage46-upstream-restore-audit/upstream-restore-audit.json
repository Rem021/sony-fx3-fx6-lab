  "source_facts": [
    {
      "id": "S01",
      "fact": "Checkpoint same_body requires ILCE-7CM2 and a shared non-conflicting body identifier; current direct and archive operations require2.01.",
      "sources": [
        "src/looks/looktool/checkpoint.py",
        "src/looks/looktool/direct.py"
      ]
    },
    {
      "id": "S02",
      "fact": "Built-in factory recovery reconstructs declared program regions and selected look/color defaults over fresh current bytes; it does not create a complete body backup. Archive rollback is a separate same-body checkpoint path.",
      "sources": [
        "src/looks/looktool/direct.py",
        "src/desktopapp/official.py",
        "src/looks/looktool/checkpoint.py"
      ]
    },
    {
      "id": "S03",
      "fact": "Fresh transactions preserve unknown outcomes; invoke records stage/execute intents, compares staged bytes and marks unknown on native-result failure. Recovery reconnects an existing authenticated0336 endpoint with recorded body identity; not a HID0D68 bootloader recovery path.",
      "sources": [
        "src/looks/looktool/devicesession.py",
        "src/camera_runtime/transport.py",
        "src/looks/looktool/factoryrecover.py"
      ]
    },
    {
      "id": "S04",
      "fact": "BYTE_WINDOWS_ONLY native workers verify edited windows and host direct flow later compares full program bytes. Automatic reverse patch is within the current worker; multiple host batches are not thereby one atomic power-loss transaction.",
      "sources": [
        "src/fl23/native/installer.c",
        "src/looks/looktool/checkpointworker.py",
        "src/looks/looktool/direct.py"
      ]
    },
    {
      "id": "S05",
      "fact": "Installer hardcodes two files and /dev/nflasha15 /usr ext2 mount; WBI worker admits only image_mode2 and image_dev*wbi4 before drop1/mode0 and fresh log checks. These constants are not FX3 live-state observations.",
      "sources": [
        "src/fl23/native/installer.c",
        "src/fl23/native/wbi.c"
      ]
    },
    {
      "id": "S06",
      "fact": "Direct verify requires changed boot_id when awaiting reload, target readback and read-only mount for factory reset; runtime worker samples6 AP spans totalling218bytes, with additional feature checks in other branches. This is not complete CP/video loaded-memory verification.",
      "sources": [
        "src/looks/looktool/direct.py",
        "src/fl23/native/runtime.c"
      ]
    },
    {
      "id": "S07",
      "fact": "A read-only application/runtime probe still stages and executes a native module, writes temporary reports and uses active/authenticated service access. It exceeds current FX3 cached-PnP authorization.",
      "sources": [
        "src/looks/looktool/devicesession.py",
        "src/fl23/native/runtime.c"
      ]
    }
  ],
