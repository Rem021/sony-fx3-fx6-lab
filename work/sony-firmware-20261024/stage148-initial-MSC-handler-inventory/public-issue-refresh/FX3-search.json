other_user}","gists_url":"https://api.github.com/users/dhxdltx/gists{/gist_id}","starred_url":"https://api.github.com/users/dhxdltx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dhxdltx/subscriptions","organizations_url":"https://api.github.com/users/dhxdltx/orgs","repos_url":"https://api.github.com/users/dhxdltx/repos","events_url":"https://api.github.com/users/dhxdltx/events{/privacy}","received_events_url":"https://api.github.com/users/dhxdltx/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2024-03-01T11:47:57Z","updated_at":"2025-01-11T22:46:54Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"My camera is SLT-A77, the machine is the Chinese PAL version, and the video is only 25p/50p.\r\nThere is no option in the menu to switch between NTSC and PAL formats.\r\nWhen I tried using pmca-gui\r\nWhen \"Enable PAL/NTSC selector&warning\" is selected, the video format in the menu is 25p/50p/50i, and there is no switching option in the menu. The captured video is in the corresponding format.\r\nWhen \"Enable PAL/NTSC selector&warning\" is unchecked, the video format in the menu is 24p/60p/60i, and there is still no switching option in the menu. At this point, if you shoot a 60p video, the file will still be 50p. When selecting 24p or 60i, press the capture button and the camera will freeze until the battery is removed.\r\nIf someone could help I'd appreciate it.\r\n\r\n","reactions":{"url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE/issues/490/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE/issues/490/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE/issues/717","repository_url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE","labels_url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE/issues/717/labels{/name}","comments_url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE/issues/717/comments","events_url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE/issues/717/events","html_url":"https://github.com/ma1co/Sony-PMCA-RE/issues/717","id":4623925768,"node_id":"I_kwDOAh3ZFM8AAAABE5uCCA","number":717,"title":"Request for backup dumps","user":{"login":"LAK132","id":1386467,"node_id":"MDQ6VXNlcjEzODY0Njc=","avatar_url":"https://avatars.githubusercontent.com/u/1386467?v=4","gravatar_id":"","url":"https://api.github.com/users/LAK132","html_url":"https://github.com/LAK132","followers_url":"https://api.github.com/users/LAK132/followers","following_url":"https://api.github.com/users/LAK132/following{/other_user}","gists_url":"https://api.github.com/users/LAK132/gists{/gist_id}","starred_url":"https://api.github.com/users/LAK132/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LAK132/subscriptions","organizations_url":"https://api.github.com/users/LAK132/orgs","repos_url":"https://api.github.com/users/LAK132/repos","events_url":"https://api.github.com/users/LAK132/events{/privacy}","received_events_url":"https://api.github.com/users/LAK132/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-06-09T16:55:54Z","updated_at":"2026-07-12T23:25:59Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"[My fork](https://github.com/LAK132/Sony-PMCA-RE) added a new `bk dump-txt <path>` command to `serviceshell` that will dump a .bin and .txt of the attached camera's backup file. If people are able to provide copies of the .txt file for ***factory reset*** cameras it will help with finding out how settings vary by region and model. Please also provide a copy of the output of `info` (in `serviceshell`):\n\n<img width=\"426\" height=\"171\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/f9bbcd7d-f25c-487b-8f61-2f62b79b70ce\" />\n\nChanging a single setting (region, language, etc) and dumping the backup again may also help narrow down particular settings for cameras that otherwise have them limited or removed from the UI.\n\n(Doing this with my unlocked a7RV is what allowed me to figure out https://github.com/ma1co/Sony-PMCA-RE/pull/714 to change frequency on my locked a7SIII)\n\n# Be aware these dumps *may* contain sensitive information (serial numbers, or literally any data on the camera), upload at your own risk\n\n","reactions":{"url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE/issues/717/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE/issues/717/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE/issues/499","repository_url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE","labels_url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE/issues/499/labels{/name}","comments_url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE/issues/499/comments","events_url":"https://api.github.com/repos/ma1co/Sony-PMCA-RE/issues/499/events","html_url":"https://github.com/ma1co/Sony-PMCA-RE/issues/499","id":2198272156,"node_id":"I_kwDOAh3ZFM6DBvic","number":499,"title":"How to enabe PAL/NTSC Selector on Sony A7IV","user":{"login":"tuye