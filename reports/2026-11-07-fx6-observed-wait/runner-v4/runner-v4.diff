+def verify_only_shim_record_changed(parent,derived,payload):
+    before,btail = cpio_raw_records(Path(parent['path']))
+    after,atail = cpio_raw_records(Path(derived['path']))
+    if btail != atail or len(before) != len(after) or [r['name'] for r in before] != [r['name'] for r in after]:
+        raise RuntimeError('worker CPIO record order/count/tail changed')
+    if sum(r['name']=='TRAILER!!!' for r in before) != 2:
+        raise RuntimeError('expected both snapshot trailers')
+    changed = []
+    for index,(b,a) in enumerate(zip(before,after)):
+        if b['gap'] != a['gap']:
+            raise RuntimeError('worker CPIO inter-record padding changed')
+        if b['raw_sha'] != a['raw_sha']:
+            changed.append(index)
+            if b['name'] != 'usr/lib/libgrm-fbinit9.so' or b['header_except_size_sha'] != a['header_except_size_sha']:
+                raise RuntimeError('unexplained worker CPIO raw record change')
+    if len(changed) != 1:
+        raise RuntimeError('expected exactly one changed shim raw record')
+    index = changed[0]
+    for label,row in [('before',before[index]),('after',after[index])]:
+        if not isinstance(payload.get(label),dict) or any(payload[label].get(k)!=row[k] for k in ('bytes','sha256')):
+            raise RuntimeError('worker shim payload fingerprint mismatch')
