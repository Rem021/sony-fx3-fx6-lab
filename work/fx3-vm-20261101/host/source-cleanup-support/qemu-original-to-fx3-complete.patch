--- a/hw/arm/virt.c
+++ b/hw/arm/virt.c
@@ -2920,6 +2920,11 @@
         virt_set_memmap(vms, pa_bits);
     }
 
+    /* FX3 probe: preserve Sony's physical DDR domain with 2 GiB backing. */
+    if (g_strcmp0(g_getenv("FX3_VM_HIGH_DDR"), "1") == 0) {
+        vms->memmap[VIRT_MEM].base = 0x400000000ULL;
+    }
+
     /* We can probe only here because during property set
      * KVM is not available yet
      */
@@ -3150,6 +3155,18 @@
 
     memory_region_add_subregion(sysmem, vms->memmap[VIRT_MEM].base,
                                 machine->ram);
+
+    /* FX3 offline probe only: architecturally addressed ESRAM as zeroed RAM.
+     * This is not an MMIO success stub or a physical camera compatibility claim.
+     * The original kernel's cxd900xx_smp_init writes secondary boot words here.
+     */
+    if (g_strcmp0(g_getenv("FX3_VM_ESRAM_RAM"), "1") == 0) {
+        MemoryRegion *fx3_esram = g_new0(MemoryRegion, 1);
+        memory_region_init_ram(fx3_esram, NULL, "fx3.esram-mailbox-probe",
+                               0x00001000, &error_fatal);
+        memory_region_add_subregion(sysmem, 0xfe005000, fx3_esram);
+    }
+
 
     cxl_fmws_update_mmio();
 
