# OS & Editor
.DS_Store
._*
.Spotlight-V100
.Trashes
__pycache__/
*.py[cod]
*$py.class
*.dSYM/
.venv/
venv/
build-venv/

# Lock & Runtime state
.run.lock
*.lock
*.pid
*.sock

# Proprietary Sony Firmware Binaries & Large Images (BYOF - Bring Your Own Firmware)
*.cpio
*.bin
*.dat
*.DAT
*.tar
*.img
*.tlv
*.eti
*.elf
*.so
*.so.*
*.ko
*.dylib
*.a
*.o
nflasha*
pnflasha*
cnflasha*
BODYDATA*
vmlinux*
Backup*.bin
DmmCfg.bin

# Large VM & Build Artifacts
runs/*/serial.log
runs/*/*.raw
runs/*/*.bin
runs/*/*.ppm
qemu-display-build/
qemu-src/
linux-kernel/
sony-oss-fx3/
toolchains/

# Always allow text, source, and metadata files even if their prefix contains .so. or nflasha
!*.md
!*.json
!*.txt
!*.py
!*.c
!*.h
!*.cpp
!*.s
!*.S
!*.sh
!*.command
!*.patch
!*.diff
!*.dts
!*.html

