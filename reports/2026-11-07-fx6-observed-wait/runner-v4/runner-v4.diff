+def cpio_raw_records(path):
+    rows, pos = [], 0
+    with path.open('rb') as f, mmap.mmap(f.fileno(),0,access=mmap.ACCESS_READ) as data:
+        while pos+110 <= len(data):
+            previous = pos
+            if data[pos] == 0:
+                match = re.search(b'[^\x00]',data[pos:])
+                if match is None:
+                    break
+                pos += match.start()
+            h = data[pos:pos+110]
+            if h[:6] != b'070701':
+                raise RuntimeError('unsupported/malformed full newc stream')
+            values = [int(h[i:i+8],16) for i in range(6,110,8)]
+            size,namesize = values[6],values[11]
+            if not 1 <= namesize <= 4096 or pos+110+namesize > len(data):
+                raise RuntimeError('newc name bounds')
+            rawname = data[pos+110:pos+110+namesize]
+            if rawname[-1:] != b'\0' or b'\0' in rawname[:-1]:
+                raise RuntimeError('newc name terminator')
+            name = rawname[:-1].decode('utf-8')
+            start = (pos+110+namesize+3)&~3
+            end = start+size
+            nextpos = (end+3)&~3
+            if nextpos > len(data):
+                raise RuntimeError('newc payload bounds')
+            if name == 'TRAILER!!!' and size:
+                raise RuntimeError('nonempty newc trailer')
+            row = {'name':name,'bytes':size,'gap':pos-previous,
+                'raw_sha':hashlib.sha256(data[pos:nextpos]).hexdigest(),
+                'header_except_size_sha':hashlib.sha256(data[pos:pos+54]+data[pos+62:start]).hexdigest()}
+            if name == 'usr/lib/libgrm-fbinit9.so':
+                row['sha256'] = hashlib.sha256(data[start:end]).hexdigest()
+            rows.append(row)
+            pos = nextpos
+        if any(data[pos:]):
+            raise RuntimeError('unparsed nonzero newc tail')
+        tail = len(data)-pos
+    return rows,tail
+
